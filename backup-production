#!/usr/bin/env bash
#
# Production backup tool for Laravel + MySQL projects.
#
# Connects to the production server over SSH and pulls a full backup: the
# MySQL database, the files that are not tracked by git (uploads, product
# images) and the production .env files. Then, depending on the chosen mode:
#
#   folder  (option 1) Save everything, uncompressed, in a new timestamped
#           folder inside $BACKUP_DIR (default: a "backups" folder next to the
#           project, outside the repository).
#   local   (option 2) Also save that folder, then load the production data
#           into this local project: replace the local database and the
#           uploaded files. The local .env files are never touched. A safety
#           backup of the local database and files is saved first.
#
# USAGE
#
#   ./backup-production                 Interactive menu (1 = folder, 2 = local).
#   ./backup-production folder          Option 1 directly: save a backup folder.
#   ./backup-production local           Option 2 directly: load production locally
#                                       (still asks to type 'yes' before replacing).
#   ./backup-production local --yes     Option 2 with no questions at all
#                                       (no confirmation, no migrate prompt).
#
#   On Windows, run the same commands from PowerShell or cmd as
#   .\backup-production [...]: backup-production.cmd launches Git Bash.
#
#   Options:
#     folder|local         Mode, as a plain word (same as --mode).
#     --mode folder|local  Skip the interactive menu.
#     --yes                Do not ask for confirmation before replacing local data.
#     --config FILE        Use another config file (default: .backup-production.conf).
#     -h, --help           Show this text.
#
# OUTPUT
#
#   $BACKUP_DIR/<project>-production-<timestamp>/
#     database.sql     Plain mysqldump (--single-transaction, routines, triggers).
#     files/           FILE_PATHS and ENV_PATHS, with the project's folder layout.
#     manifest.json    Date, source, database name, deployed git commit.
#   $BACKUP_DIR/<project>-local-before-restore-<timestamp>/   (local mode only)
#     Same layout, with the local database and files as they were before.
#
#   Restore a folder by hand:
#     mysql -u <user> -p <database> < database.sql
#     cp -R files/<path> <project>/<path>
#
# CONFIG
#
#   Settings live in .backup-production.conf next to this script (gitignored).
#   Copy .backup-production.conf.example to start; every key is commented there.
#   Database credentials are never stored in the config: they are read at run
#   time from the remote Laravel config and the local backend .env.
#
#   To reuse the tool in another project, copy this script,
#   backup-production.cmd (Windows launcher), .backup-production.conf.example
#   and the .gitattributes rules (LF for this script, CRLF for .cmd), then adjust
#   the config and add .backup-production.conf to .gitignore.
#
# REQUIREMENTS
#
#   Local: bash (Git Bash on Windows), ssh, tar, gzip. The local mode also needs
#   the mysql and mysqldump clients (PATH, LOCAL_MYSQL_BIN, or an auto-detected
#   DBngin install) and php (PATH, LOCAL_PHP, or Herd's php.bat).
#   Server: bash, php, mysqldump, tar, gzip, git, and passwordless SSH access.
#
# SSH KEY SETUP (passwordless access, needed once per machine)
#
#   1. Create a key if ~/.ssh/id_ed25519 does not exist yet:
#        ssh-keygen -t ed25519
#   2. Add a Host alias to ~/.ssh/config (C:\Users\<you>\.ssh\config on
#      Windows) and use that alias as SSH_HOST. Keep one block per alias:
#      with duplicates, ssh takes the first value of each setting.
#        Host NolitaProduccion
#            HostName 147.93.8.65
#            User nolita
#            Port 22
#            IdentityFile ~/.ssh/id_ed25519
#   3. Copy the public key to the server (asks for the password one last time):
#        cat ~/.ssh/id_ed25519.pub | ssh NolitaProduccion "mkdir -p ~/.ssh && chmod 700 ~/.ssh && cat >> ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys"
#      On CloudPanel servers the key can also be added from the panel:
#      Site > SSH/FTP > edit the SSH user > SSH Keys.
#   4. Test: ssh NolitaProduccion whoami   (must not ask for a password)
#
#   Still asks for a password? Diagnose in this order:
#     - ssh -v NolitaProduccion true 2>&1 | grep -iE "identity|offering|denied"
#       "no such identity" means a wrong IdentityFile path in ~/.ssh/config.
#       "Offering public key" followed by "denied" means the server rejected it.
#     - On the server: ssh-keygen -lf ~/.ssh/authorized_keys must list the same
#       fingerprint that ssh -v printed when offering the key.
#     - On the server: ls -ld ~ ~/.ssh ~/.ssh/authorized_keys
#       sshd ignores the key when the home folder is group or world writable
#       (e.g. drwxrwx---). Fix with: chmod g-w,o-w ~
#       Expected: ~ drwxr-x--- or drwxr-xr-x, ~/.ssh drwx------,
#       authorized_keys -rw-------, all owned by the SSH user. CloudPanel can
#       reset the home permissions, so check this first if it breaks again.
#
# NOTES FOR AGENTS
#
#   - Run it from a developer machine, never on the server. It only reads from
#     production (mysqldump --single-transaction and tar, both non-locking).
#   - The local mode is destructive for the local project: it drops and
#     recreates the local database named in the backend .env and replaces the
#     FILE_PATHS folders. Never pass --yes on the user's behalf without asking.
#   - Backup folders contain production secrets (.env files): never commit,
#     upload or paste them anywhere.
#   - Flow: load_config > choose_mode > (local: tool and DB checks, confirm) >
#     download_production (two SSH calls: REMOTE_DUMP_SCRIPT streams the gzipped
#     dump, REMOTE_FILES_SCRIPT streams a tar.gz) > verify_dump > package_stage
#     > (local: backup_local > restore_into_local).
#   - Remote scripts receive REMOTE_ROOT as an argument; "~/" is expanded to the
#     SSH user's home on the server.
#   - Testing without a server: source this file (main only runs when it is
#     executed), override run_remote to run "bash -s -- "$@"" locally, point
#     REMOTE_ROOT at a local project, and use a scratch database name in a fake
#     project's .env. See docs/DEPLOY_INFO.md for the user-facing summary.
#
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="$ROOT_DIR/.backup-production.conf"
MODE=""
ASSUME_YES=0
TIMESTAMP="$(date +%Y%m%d-%H%M%S)"
WORK_DIR=""
SSH_ARGS=()
MYSQL_BIN=""
MYSQLDUMP_BIN=""
PHP_BIN=""

log() { printf '\n\033[1;36m==> %s\033[0m\n' "$1"; }
info() { printf '    %s\n' "$1"; }
warn() { printf '\033[1;33m    %s\033[0m\n' "$1"; }
fail() { printf '\n\033[1;31mBackup failed: %s\033[0m\n' "$1" >&2; exit 1; }

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "missing command: $1"
}

# Converts "D:\Vimana\Backups" or "D:/Vimana/Backups" into a path bash can use.
unix_path() {
  if command -v cygpath >/dev/null 2>&1; then
    cygpath -u "$1"
  else
    printf '%s\n' "$1"
  fi
}

# Native Windows programs (mysql.exe, tar.exe, php.bat) need Windows paths.
native_path() {
  if command -v cygpath >/dev/null 2>&1; then
    cygpath -w "$1"
  else
    printf '%s\n' "$1"
  fi
}

cleanup() {
  [ -n "$WORK_DIR" ] && rm -rf "$WORK_DIR"
  return 0
}
trap cleanup EXIT

load_config() {
  [ -f "$CONFIG_FILE" ] || fail "missing $CONFIG_FILE. Copy .backup-production.conf.example and fill it in."

  # shellcheck source=/dev/null
  source "$CONFIG_FILE"

  : "${PROJECT_NAME:?PROJECT_NAME is not set in the config}"
  : "${SSH_HOST:?SSH_HOST is not set in the config}"
  : "${REMOTE_ROOT:?REMOTE_ROOT is not set in the config}"
  BACKEND_DIR="${BACKEND_DIR:-.}"
  FILE_PATHS="${FILE_PATHS:-}"
  ENV_PATHS="${ENV_PATHS:-}"
  POST_RESTORE_SQL="${POST_RESTORE_SQL:-}"

  SSH_ARGS=(-o ConnectTimeout=15)
  if [ -n "${SSH_PORT:-}" ]; then SSH_ARGS+=(-p "$SSH_PORT"); fi
  if [ -n "${SSH_KEY:-}" ]; then SSH_ARGS+=(-i "$(unix_path "$SSH_KEY")" -o IdentitiesOnly=yes); fi

  # Relative paths are resolved from the project root. The default sits next to
  # the repository, so backups never end up inside it.
  BACKUP_DIR="$(unix_path "${BACKUP_DIR:-../backups}")"
  case "$BACKUP_DIR" in
    /*) ;;
    *) BACKUP_DIR="$ROOT_DIR/$BACKUP_DIR" ;;
  esac
  mkdir -p "$BACKUP_DIR" || fail "could not create $BACKUP_DIR"
  BACKUP_DIR="$(cd "$BACKUP_DIR" && pwd)"
  SLUG="$(printf '%s' "$PROJECT_NAME" | tr '[:upper:] ' '[:lower:]-')"
}

choose_mode() {
  [ -n "$MODE" ] && return 0

  printf '\nProduction backup for %s (%s)\n\n' "$PROJECT_NAME" "$SSH_HOST"
  printf '  1) Save a backup folder in %s\n' "$(native_path "$BACKUP_DIR")"
  printf '  2) Load production into this local project (also saves the backup folder)\n\n'

  local answer
  read -r -p 'Choose an option [1/2]: ' answer
  case "$answer" in
    1) MODE="folder" ;;
    2) MODE="local" ;;
    *) fail "invalid option: $answer" ;;
  esac
}

confirm() {
  [ "$ASSUME_YES" = "1" ] && return 0
  local answer
  read -r -p "$1 Type 'yes' to continue: " answer
  [ "$answer" = "yes" ] || fail "cancelled. Nothing was changed."
}

run_remote() {
  # Every argument is quoted for the remote shell, then the script comes on stdin.
  local quoted="" arg
  for arg in "$@"; do
    quoted+=" $(printf '%q' "$arg")"
  done
  ssh "${SSH_ARGS[@]}" "$SSH_HOST" "bash -s --$quoted"
}

# --- Production download ------------------------------------------------------

# Remote side: reads the resolved Laravel database config (handles quoting and a
# cached config) and streams a gzipped, consistent dump to stdout.
REMOTE_DUMP_SCRIPT='
set -euo pipefail
dir="$1"
case "$dir" in "~") dir="$HOME" ;; "~/"*) dir="$HOME/${dir#"~/"}" ;; esac
cd "$dir" 2>/dev/null || { echo "remote folder not found: $dir (user $(whoami), home $HOME)" >&2; exit 1; }
db_output="$(php -r "
  require \"vendor/autoload.php\";
  \$app = require \"bootstrap/app.php\";
  \$app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();
  \$c = config(\"database.connections.\".config(\"database.default\"));
  foreach ([\$c[\"driver\"] ?? \"\", \$c[\"host\"] ?? \"127.0.0.1\", \$c[\"port\"] ?? \"3306\",
            \$c[\"database\"] ?? \"\", \$c[\"username\"] ?? \"\", \$c[\"password\"] ?? \"\"] as \$v) {
      echo \$v, PHP_EOL;
  }
")"
mapfile -t db <<< "${db_output//$'\''\r'\''/}"
[ "${db[0]:-}" = "mysql" ] || { echo "expected the mysql driver but found ${db[0]:-none}" >&2; exit 1; }
defaults_file="$(mktemp)"
trap "rm -f \"$defaults_file\"" EXIT
chmod 600 "$defaults_file"
printf "[client]\nuser=%s\npassword=%s\nhost=%s\nport=%s\n" "${db[4]:-}" "${db[5]:-}" "${db[1]:-}" "${db[2]:-}" > "$defaults_file"
echo "${db[3]:-}" >&2
mysqldump --defaults-extra-file="$defaults_file" \
  --single-transaction --quick --routines --events --triggers \
  --no-tablespaces --default-character-set=utf8mb4 "${db[3]}" | gzip
'

# Remote side: streams a tar.gz with the requested paths (missing ones are
# skipped) plus a small file with the deployed git commit.
REMOTE_FILES_SCRIPT='
set -euo pipefail
dir="$1"
case "$dir" in "~") dir="$HOME" ;; "~/"*) dir="$HOME/${dir#"~/"}" ;; esac
cd "$dir" 2>/dev/null || { echo "remote folder not found: $dir (user $(whoami), home $HOME)" >&2; exit 1; }
shift
meta_dir="$(mktemp -d)"
trap "rm -rf \"$meta_dir\"" EXIT
git rev-parse HEAD > "$meta_dir/production-commit.txt" 2>/dev/null || echo unknown > "$meta_dir/production-commit.txt"
existing=()
for path in "$@"; do
  if [ -e "$path" ]; then existing+=("$path"); else echo "skipped (not found): $path" >&2; fi
done
tar -czf - "${existing[@]}" -C "$meta_dir" production-commit.txt
'

download_production() {
  local stage="$1"
  mkdir -p "$stage/files"

  log "Dumping the production database"
  local db_name_file="$WORK_DIR/remote-db-name"
  if ! run_remote "$REMOTE_ROOT/$BACKEND_DIR" < <(printf '%s' "$REMOTE_DUMP_SCRIPT") \
      > "$stage/database.sql.gz" 2> "$db_name_file"; then
    cat "$db_name_file" >&2
    fail "the remote database dump failed"
  fi
  verify_dump "$stage/database.sql.gz"
  PROD_DB_NAME="$(head -n 1 "$db_name_file")"

  log "Downloading files and .env files"
  local paths=()
  read -r -a paths <<< "$FILE_PATHS $ENV_PATHS"
  if ! run_remote "$REMOTE_ROOT" "${paths[@]}" < <(printf '%s' "$REMOTE_FILES_SCRIPT") \
      > "$WORK_DIR/files.tar.gz"; then
    fail "the remote file archive failed"
  fi
  tar -xzf "$WORK_DIR/files.tar.gz" -C "$stage/files"
  rm -f "$WORK_DIR/files.tar.gz"
  mv "$stage/files/production-commit.txt" "$WORK_DIR/production-commit.txt"
  info "Files: $(du -sh "$stage/files" | cut -f1)"
}

# A truncated dump still gunzips cleanly, so check the mysqldump trailer too.
verify_dump() {
  [ -s "$1" ] || fail "the dump is empty"
  gzip -t "$1" 2>/dev/null || fail "the dump is corrupt"
  gzip -dc "$1" | tail -n 5 | grep -q 'Dump completed' || fail "the dump is truncated: no completion marker"
  info "Database: $(du -h "$1" | cut -f1), $(gzip -dc "$1" | grep -c '^CREATE TABLE' || true) tables"
}

write_manifest() {
  local stage="$1" source="$2" database="$3" commit="$4"
  cat > "$stage/manifest.json" <<EOF
{
  "project": "$PROJECT_NAME",
  "source": "$source",
  "created_at": "$(date '+%Y-%m-%dT%H:%M:%S%z')",
  "database": "$database",
  "git_commit": "$commit",
  "file_paths": "$FILE_PATHS",
  "env_paths": "$ENV_PATHS"
}
EOF
}

# Turns a verified stage into a plain backup folder: the dump is stored as an
# uncompressed database.sql (images are already compressed, so archiving them
# saves nothing) and the folder is moved into $BACKUP_DIR. The stage lives in
# $BACKUP_DIR too, so the move is instant. Sets PACKAGED_DIR.
package_stage() {
  local stage="$1" name="$2" target="$BACKUP_DIR/$2"

  [ -e "$target" ] && fail "already exists: $target"
  if [ -f "$stage/database.sql.gz" ]; then
    gzip -d "$stage/database.sql.gz" || fail "could not decompress the dump"
  fi
  mv "$stage" "$target" || fail "could not create $target"

  PACKAGED_DIR="$target"
  info "Saved $(native_path "$target") ($(du -sh "$target" | cut -f1))"
}

# --- Local project -------------------------------------------------------------

find_local_tools() {
  local candidates=() dir

  if [ -n "${LOCAL_MYSQL_BIN:-}" ]; then candidates+=("$(unix_path "$LOCAL_MYSQL_BIN")"); fi
  if command -v mysql >/dev/null 2>&1; then
    candidates+=("$(dirname "$(command -v mysql)")")
  fi
  if [ -n "${LOCALAPPDATA:-}" ]; then
    # DBngin installs one folder per version; prefer the newest.
    while IFS= read -r dir; do
      candidates+=("$dir")
    done < <(ls -d "$(unix_path "$LOCALAPPDATA")"/com.tinyapp.DBngin/Binaries/mysql/*/bin 2>/dev/null | sort -rV)
  fi

  for dir in "${candidates[@]}"; do
    if [ -x "$dir/mysql" ] || [ -x "$dir/mysql.exe" ]; then
      MYSQL_BIN="$dir/mysql"
      MYSQLDUMP_BIN="$dir/mysqldump"
      break
    fi
  done
  [ -n "$MYSQL_BIN" ] || fail "mysql client not found. Set LOCAL_MYSQL_BIN in the config."

  if [ -n "${LOCAL_PHP:-}" ]; then
    PHP_BIN="$(unix_path "$LOCAL_PHP")"
  elif command -v php >/dev/null 2>&1; then
    PHP_BIN="php"
  elif command -v php.bat >/dev/null 2>&1; then
    PHP_BIN="php.bat"
  else
    fail "php not found. Set LOCAL_PHP in the config."
  fi

  info "mysql: $MYSQL_BIN"
  info "php: $PHP_BIN"
}

# Reads DB_* from the local backend .env (simple KEY=value lines).
read_local_db_config() {
  local env_file="$ROOT_DIR/$BACKEND_DIR/.env"
  [ -f "$env_file" ] || fail "missing $env_file"

  env_value() {
    local value
    value="$(grep -E "^$1=" "$env_file" | tail -n 1 | cut -d= -f2- | tr -d '\r' || true)"
    value="${value%\"}"; value="${value#\"}"
    value="${value%\'}"; value="${value#\'}"
    printf '%s' "${value:-$2}"
  }

  LOCAL_DB_DRIVER="$(env_value DB_CONNECTION mysql)"
  LOCAL_DB_HOST="$(env_value DB_HOST 127.0.0.1)"
  LOCAL_DB_PORT="$(env_value DB_PORT 3306)"
  LOCAL_DB_NAME="$(env_value DB_DATABASE '')"
  LOCAL_DB_USER="$(env_value DB_USERNAME root)"
  LOCAL_DB_PASS="$(env_value DB_PASSWORD '')"

  [ "$LOCAL_DB_DRIVER" = "mysql" ] || fail "local DB_CONNECTION is '$LOCAL_DB_DRIVER', expected mysql"
  [ -n "$LOCAL_DB_NAME" ] || fail "local DB_DATABASE is empty"
}

# Credentials go in a private defaults file, never on the command line.
write_local_defaults_file() {
  LOCAL_DEFAULTS_FILE="$WORK_DIR/local-my.cnf"
  printf '[client]\nuser=%s\npassword=%s\nhost=%s\nport=%s\n' \
    "$LOCAL_DB_USER" "$LOCAL_DB_PASS" "$LOCAL_DB_HOST" "$LOCAL_DB_PORT" > "$LOCAL_DEFAULTS_FILE"
  chmod 600 "$LOCAL_DEFAULTS_FILE"
}

local_mysql() {
  "$MYSQL_BIN" --defaults-extra-file="$(native_path "$LOCAL_DEFAULTS_FILE")" "$@"
}

local_database_exists() {
  [ -n "$(local_mysql -N -e "SHOW DATABASES LIKE '$1'")" ]
}

backup_local() {
  local stage="$WORK_DIR/local"
  mkdir -p "$stage/files"

  log "Saving a safety backup of the local project"
  if local_database_exists "$LOCAL_DB_NAME"; then
    "$MYSQLDUMP_BIN" --defaults-extra-file="$(native_path "$LOCAL_DEFAULTS_FILE")" \
      --single-transaction --quick --routines --events --triggers \
      --no-tablespaces --default-character-set=utf8mb4 "$LOCAL_DB_NAME" | gzip > "$stage/database.sql.gz" \
      || fail "the local database dump failed"
    verify_dump "$stage/database.sql.gz"
  else
    warn "Local database $LOCAL_DB_NAME does not exist yet. Only files are saved."
  fi

  local path existing=()
  for path in $FILE_PATHS; do
    if [ -e "$ROOT_DIR/$path" ]; then existing+=("$path"); fi
  done
  if [ "${#existing[@]}" -gt 0 ]; then
    tar -cf - -C "$ROOT_DIR" "${existing[@]}" | tar -xf - -C "$stage/files"
  fi

  write_manifest "$stage" "local" "$LOCAL_DB_NAME" "$(git -C "$ROOT_DIR" rev-parse HEAD 2>/dev/null || echo unknown)"
  package_stage "$stage" "$SLUG-local-before-restore-$TIMESTAMP"
}

# Imports a .sql or .sql.gz dump into a fresh database with the given name.
import_database() {
  local dump="$1" db_name="$2" reader=(cat)

  case "$dump" in *.gz) reader=(gzip -dc) ;; esac
  local_mysql -e "DROP DATABASE IF EXISTS \`$db_name\`; CREATE DATABASE \`$db_name\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" \
    || fail "could not recreate the local database $db_name"
  "${reader[@]}" "$dump" | local_mysql --default-character-set=utf8mb4 "$db_name" \
    || fail "the import into $db_name failed. Restore the safety backup if needed."
  info "Imported $(local_mysql -N -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = '$db_name'") tables into $db_name"
}

# Replaces each local FILE_PATHS entry with the production copy. .env files are
# never restored: the local project keeps its own configuration.
restore_files() {
  local stage="$1" path

  for path in $FILE_PATHS; do
    if [ -e "$stage/files/$path" ]; then
      rm -rf "${ROOT_DIR:?}/$path"
      mkdir -p "$(dirname "$ROOT_DIR/$path")"
      cp -R "$stage/files/$path" "$ROOT_DIR/$path"
      info "Restored $path"
    else
      warn "Not in the production backup, left as is: $path"
    fi
  done
}

artisan() {
  (cd "$ROOT_DIR/$BACKEND_DIR" && "$PHP_BIN" artisan "$@")
}

restore_into_local() {
  local stage="$1"

  log "Loading production into the local project"
  import_database "$stage/database.sql" "$LOCAL_DB_NAME"

  if [ -n "$POST_RESTORE_SQL" ]; then
    local_mysql -e "$POST_RESTORE_SQL" "$LOCAL_DB_NAME" \
      && info "Ran POST_RESTORE_SQL" \
      || warn "POST_RESTORE_SQL failed: $POST_RESTORE_SQL"
  fi

  restore_files "$stage"

  if [ -f "$ROOT_DIR/$BACKEND_DIR/artisan" ]; then
    artisan storage:link >/dev/null 2>&1 || true
    artisan optimize:clear >/dev/null || warn "php artisan optimize:clear failed"
    info "Cleared Laravel caches"

    if [ "$ASSUME_YES" = "0" ]; then
      local answer
      read -r -p 'Run local pending migrations now? [y/N]: ' answer
      case "$answer" in
        y|Y|yes) artisan migrate ;;
      esac
    fi
  fi
}

# --- Entry point ---------------------------------------------------------------

main() {
  while [ $# -gt 0 ]; do
    case "$1" in
      folder|local) MODE="$1" ;;
      --mode) MODE="${2:-}"; shift ;;
      --yes) ASSUME_YES=1 ;;
      --config) CONFIG_FILE="${2:-}"; shift ;;
      # Prints the header comment block, from line 2 up to the first code line.
      -h|--help) awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "${BASH_SOURCE[0]}"; exit 0 ;;
      *) fail "unknown option: $1" ;;
    esac
    shift
  done
  case "$MODE" in ""|folder|local) ;; *) fail "--mode must be folder or local" ;; esac

  require_command ssh
  require_command tar
  require_command gzip
  load_config
  choose_mode

  mkdir -p "$BACKUP_DIR" || fail "could not create $BACKUP_DIR"
  WORK_DIR="$(mktemp -d "$BACKUP_DIR/.tmp-XXXXXX")"
  local stage="$WORK_DIR/production"

  # Check the local side before downloading, so a bad local setup fails fast.
  if [ "$MODE" = "local" ]; then
    log "Checking the local project"
    find_local_tools
    read_local_db_config
    write_local_defaults_file
    local_mysql -e "SELECT 1" >/dev/null || fail "cannot connect to the local MySQL at $LOCAL_DB_HOST:$LOCAL_DB_PORT"
    info "Local database: $LOCAL_DB_NAME on $LOCAL_DB_HOST:$LOCAL_DB_PORT"
    confirm "This replaces the local database '$LOCAL_DB_NAME' and these folders: $FILE_PATHS."
  fi

  download_production "$stage"
  write_manifest "$stage" "$SSH_HOST:$REMOTE_ROOT" "$PROD_DB_NAME" "$(cat "$WORK_DIR/production-commit.txt")"

  log "Packaging the production backup"
  package_stage "$stage" "$SLUG-production-$TIMESTAMP"
  local production_dir="$PACKAGED_DIR"

  if [ "$MODE" = "local" ]; then
    backup_local
    restore_into_local "$production_dir"
  fi

  log "Done"
}

# Only run when executed, so the functions can be sourced for testing.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
