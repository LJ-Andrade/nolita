#!/usr/bin/env bash
#
# Production release script for Nolita (VADMIN API + admin panel + Next.js storefront) on Debian.
#
# Dumps the database first and aborts the whole release if that fails. Then
# pulls main, refreshes dependencies when their lockfiles changed, builds the
# admin panel into a staging folder and swaps it in, runs migrations and cache
# warm-up behind maintenance mode, and rebuilds the storefront when it changed.
#
# Usage: ./fulldeploy [options]
#
#   --skip-admin      Do not rebuild admin/frontend.
#   --build-web       Rebuild the storefront even if web/ did not change in this pull.
#   --skip-web        Never rebuild the storefront.
#   --no-maintenance  Run migrations without putting the API in maintenance mode.
#   --force-deps      Reinstall composer and admin npm dependencies even if unchanged.
#   --allow-dirty     Continue when the working tree has local modifications.
#   --reload-fpm      Reload PHP-FPM at the end (requires sudo, never fatal).
#   --skip-backup     Deploy without a database dump. Migrations become
#                     irreversible: use only when the dump itself is broken.
#
# Everything below lives inside main(). `git pull` can rewrite this file while
# it is running, and bash reads scripts lazily from disk: a plain top-level
# body would silently stop at the pull and still exit 0, skipping migrations
# and leaving the site in maintenance mode. Bash parses a function in full
# before running it, so the version that started is the version that finishes.
#
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND_DIR="$ROOT_DIR/admin/backend"
FRONTEND_DIR="$ROOT_DIR/admin/frontend"
WEB_DIR="$ROOT_DIR/web"
# Sibling of the project directory, so a bad checkout can never reach the dumps.
BACKUP_DIR="$(dirname "$ROOT_DIR")/backup"
BACKUP_KEEP=10
BRANCH="main"

SKIP_ADMIN=0
WEB_MODE="auto"
USE_MAINTENANCE=1
FORCE_DEPS=0
ALLOW_DIRTY=0
RELOAD_FPM=0
SKIP_BACKUP=0
MAINTENANCE_ON=0
changed_files=""

log() { printf '\n\033[1;36m==> %s\033[0m\n' "$1"; }
info() { printf '    %s\n' "$1"; }
warn() { printf '\033[1;33m    %s\033[0m\n' "$1"; }
fail() { printf '\n\033[1;31mDeploy failed: %s\033[0m\n' "$1" >&2; exit 1; }

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "missing command: $1"
}

# True when the pull touched the given file, or when deps were forced.
changed() {
  [ "$FORCE_DEPS" = "1" ] && return 0
  printf '%s\n' "$changed_files" | grep -qx "$1"
}

# True when the pull touched anything under the given directory prefix.
changed_under() {
  printf '%s\n' "$changed_files" | grep -q "^$1"
}

# Always lift maintenance mode, including when a step aborts the script.
cleanup() {
  local exit_code=$?

  if [ "$MAINTENANCE_ON" = "1" ]; then
    log "Lifting maintenance mode"
    (cd "$BACKEND_DIR" && php artisan up) || \
      printf '\033[1;31mCould not lift maintenance mode. Run: cd %s && php artisan up\033[0m\n' "$BACKEND_DIR" >&2
    MAINTENANCE_ON=0
  fi

  rm -rf "$FRONTEND_DIR/dist-release"

  if [ "$exit_code" != "0" ]; then
    printf '\n\033[1;31mDeploy aborted with exit code %s.\033[0m\n' "$exit_code" >&2
  fi
}
trap cleanup EXIT

backup_database() {
  log "Backing up the database"
  require_command mysqldump
  require_command gzip

  # Read the resolved Laravel config instead of parsing .env, so quoting,
  # a cached config, and non-default connections are all handled correctly.
  local db_output
  db_output="$(cd "$BACKEND_DIR" && php -r '
    require "vendor/autoload.php";
    $app = require "bootstrap/app.php";
    $app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();
    $name = config("database.default");
    $c = config("database.connections.".$name);
    foreach ([$c["driver"] ?? "", $c["host"] ?? "127.0.0.1", $c["port"] ?? "3306",
              $c["database"] ?? "", $c["username"] ?? "", $c["password"] ?? ""] as $value) {
        echo $value, "\n";
    }
  ')" || fail "could not read the database configuration"

  local db_config
  mapfile -t db_config <<< "$db_output"

  local db_driver="${db_config[0]:-}"
  local db_host="${db_config[1]:-}"
  local db_port="${db_config[2]:-}"
  local db_name="${db_config[3]:-}"
  local db_user="${db_config[4]:-}"
  local db_pass="${db_config[5]:-}"

  [ "$db_driver" = "mysql" ] || fail "expected the mysql driver but found '$db_driver'"
  [ -n "$db_name" ] || fail "the database name is empty"

  mkdir -p "$BACKUP_DIR" || fail "could not create $BACKUP_DIR"
  [ -w "$BACKUP_DIR" ] || fail "$BACKUP_DIR is not writable"

  # Credentials go in a private defaults file so they never reach the process
  # list, where any user on the box could read them.
  local defaults_file
  defaults_file="$(mktemp)"
  chmod 600 "$defaults_file"
  printf '[client]\nuser=%s\npassword=%s\nhost=%s\nport=%s\n' \
    "$db_user" "$db_pass" "$db_host" "$db_port" > "$defaults_file"

  local backup_file="$BACKUP_DIR/${db_name}-$(date +%Y%m%d-%H%M%S).sql.gz"

  # --single-transaction takes a consistent InnoDB snapshot without locking
  # the tables, so the API and storefront keep serving while the dump runs.
  # --no-tablespaces skips metadata that needs the global PROCESS privilege,
  # which a least-privilege application user does not have.
  if ! mysqldump --defaults-extra-file="$defaults_file" \
      --single-transaction --quick --routines --events --triggers \
      --no-tablespaces --default-character-set=utf8mb4 "$db_name" | gzip > "$backup_file"; then
    rm -f "$defaults_file" "$backup_file"
    fail "mysqldump failed. Nothing was deployed."
  fi

  rm -f "$defaults_file"

  gzip -t "$backup_file" 2>/dev/null || { rm -f "$backup_file"; fail "the dump is corrupt. Nothing was deployed."; }
  [ -s "$backup_file" ] || { rm -f "$backup_file"; fail "the dump is empty. Nothing was deployed."; }

  # A truncated dump still gzips and decompresses cleanly, so the only reliable
  # completeness signal is the trailer mysqldump writes when it finishes.
  if ! gzip -dc "$backup_file" | tail -5 | grep -q 'Dump completed'; then
    rm -f "$backup_file"
    fail "the dump is truncated: no completion marker. Nothing was deployed."
  fi

  local table_count
  table_count="$(gzip -dc "$backup_file" | grep -c '^CREATE TABLE' || true)"
  info "Saved $backup_file ($(du -h "$backup_file" | cut -f1), $table_count tables)"

  # Keep the most recent dumps only.
  ls -1t "$BACKUP_DIR/${db_name}-"*.sql.gz 2>/dev/null | tail -n "+$((BACKUP_KEEP + 1))" | \
    while read -r stale; do
      info "Removing old backup $(basename "$stale")"
      rm -f "$stale"
    done
}

# Builds the panel into dist-release and swaps it in with two renames, so Nginx
# never serves a half-written dist/ while the build runs.
build_admin() {
  if changed "admin/frontend/package-lock.json" || [ ! -d "$FRONTEND_DIR/node_modules" ]; then
    log "Installing admin npm dependencies"
    (cd "$FRONTEND_DIR" && npm ci)
  else
    info "admin package-lock.json unchanged, skipping npm ci."
  fi

  log "Building the admin panel"
  rm -rf "$FRONTEND_DIR/dist-release"
  (cd "$FRONTEND_DIR" && npm run build -- --outDir dist-release --emptyOutDir)

  [ -f "$FRONTEND_DIR/dist-release/index.html" ] || fail "the admin build produced no index.html. The live panel was not touched."

  # The Sentry plugin only deletes maps under ./dist, so never publish them from the staging folder.
  find "$FRONTEND_DIR/dist-release" -name '*.map' -type f -delete

  log "Publishing the admin panel"
  rm -rf "$FRONTEND_DIR/dist-previous"
  if [ -d "$FRONTEND_DIR/dist" ]; then
    mv "$FRONTEND_DIR/dist" "$FRONTEND_DIR/dist-previous"
  fi
  mv "$FRONTEND_DIR/dist-release" "$FRONTEND_DIR/dist"
  info "Previous panel kept in admin/frontend/dist-previous for a quick rollback."
}

main() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --skip-admin) SKIP_ADMIN=1 ;;
      --build-web) WEB_MODE="always" ;;
      --skip-web) WEB_MODE="never" ;;
      --no-maintenance) USE_MAINTENANCE=0 ;;
      --force-deps) FORCE_DEPS=1 ;;
      --allow-dirty) ALLOW_DIRTY=1 ;;
      --reload-fpm) RELOAD_FPM=1 ;;
      --skip-backup) SKIP_BACKUP=1 ;;
      -h|--help) sed -n '2,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
      *) fail "unknown option: $1" ;;
    esac
    shift
  done

  log "Checking environment"
  require_command git
  require_command php
  require_command composer
  require_command npm
  [ -f "$BACKEND_DIR/artisan" ] || fail "missing $BACKEND_DIR/artisan"
  [ -f "$BACKEND_DIR/.env" ] || fail "missing $BACKEND_DIR/.env"
  [ -f "$FRONTEND_DIR/package.json" ] || fail "missing $FRONTEND_DIR/package.json"
  [ -f "$WEB_DIR/package.json" ] || fail "missing $WEB_DIR/package.json"
  [ -x "$ROOT_DIR/build-web.sh" ] || fail "missing or not executable: $ROOT_DIR/build-web.sh"
  info "php $(php -r 'echo PHP_VERSION;')"
  info "node $(node --version) / npm $(npm --version)"

  # The build reads VITE_API_URL from here. Without it the panel silently falls
  # back to the development API host and production breaks after the build.
  if [ "$SKIP_ADMIN" = "0" ]; then
    [ -f "$FRONTEND_DIR/.env.production" ] || \
      fail "missing $FRONTEND_DIR/.env.production. It must define VITE_API_URL."
    grep -q '^VITE_API_URL=.\+' "$FRONTEND_DIR/.env.production" || \
      fail "VITE_API_URL is not set in $FRONTEND_DIR/.env.production"
    info "VITE_API_URL $(grep '^VITE_API_URL=' "$FRONTEND_DIR/.env.production" | cut -d= -f2-)"
  fi

  cd "$ROOT_DIR"

  local current_branch
  current_branch="$(git rev-parse --abbrev-ref HEAD)"
  [ "$current_branch" = "$BRANCH" ] || fail "expected branch $BRANCH but found $current_branch"

  if [ "$ALLOW_DIRTY" = "0" ] && [ -n "$(git status --porcelain)" ]; then
    git status --short
    fail "the working tree has local changes. Commit, stash, or pass --allow-dirty."
  fi

  # Runs before anything else changes on disk, and a failure stops the release:
  # migrations can alter tables and backfill data, and MySQL cannot roll DDL back.
  if [ "$SKIP_BACKUP" = "1" ]; then
    warn "Skipping the database backup. Migrations will not be reversible."
  else
    backup_database
  fi

  log "Pulling $BRANCH"
  local previous_head current_head
  previous_head="$(git rev-parse HEAD)"
  git pull --ff-only origin "$BRANCH"
  current_head="$(git rev-parse HEAD)"

  if [ "$previous_head" = "$current_head" ]; then
    info "Already up to date at $current_head."
  else
    info "$previous_head -> $current_head"
    changed_files="$(git diff --name-only "$previous_head" "$current_head")"

    if printf '%s\n' "$changed_files" | grep -qx "$(basename "${BASH_SOURCE[0]}")"; then
      warn "This deploy script changed. The running copy finishes this release;"
      warn "the next run picks up the new version."
    fi
  fi

  if changed "admin/backend/composer.lock" || [ ! -d "$BACKEND_DIR/vendor" ]; then
    log "Installing composer dependencies"
    (cd "$BACKEND_DIR" && composer install --no-dev --optimize-autoloader --no-interaction --prefer-dist)
  else
    info "composer.lock unchanged, skipping composer install."
  fi

  # The panel build runs before maintenance mode: it only writes to a staging
  # folder and does not depend on the database, so it adds no API downtime.
  if [ "$SKIP_ADMIN" = "0" ]; then
    build_admin
  else
    info "Skipping the admin panel build."
  fi

  cd "$BACKEND_DIR"

  log "Pending migrations"
  php artisan migrate:status --pending || \
    warn "Could not list pending migrations. The migrations table may not exist yet."

  if [ "$USE_MAINTENANCE" = "1" ]; then
    log "Enabling maintenance mode"
    info "While the API is down, the storefront redirects visitors to /maintenance."
    php artisan down --retry=60
    MAINTENANCE_ON=1
  fi

  log "Running migrations"
  php artisan migrate --force

  # Route middleware may depend on permissions introduced by the same release.
  log "Resetting the permission cache"
  php artisan permission:cache-reset

  if [ ! -e "public/storage" ]; then
    log "Linking the public storage disk"
    php artisan storage:link
  fi

  log "Rebuilding config, route, view, and event caches"
  php artisan optimize:clear
  php artisan optimize

  if [ "$USE_MAINTENANCE" = "1" ]; then
    log "Lifting maintenance mode"
    php artisan up
    MAINTENANCE_ON=0
  fi

  # Workers keep the old code in memory until they are told to finish the
  # current job and exit; the supervisor restarts them on the new release.
  log "Restarting queue workers"
  php artisan queue:restart

  if [ "$RELOAD_FPM" = "1" ]; then
    log "Reloading PHP-FPM"
    local fpm_service
    fpm_service="php$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;')-fpm"
    sudo systemctl reload "$fpm_service" || info "Could not reload $fpm_service. Reload it manually."
  fi

  # The storefront goes last, against the already migrated API. `next build`
  # rewrites .next while the old server keeps running, so it only runs when
  # web/ changed (or on request) to keep that window out of backend-only releases.
  cd "$ROOT_DIR"
  local build_web=0
  case "$WEB_MODE" in
    always) build_web=1 ;;
    never) build_web=0 ;;
    auto) changed_under "web/" && build_web=1 ;;
  esac

  if [ "$build_web" = "1" ]; then
    log "Building and restarting the storefront"
    "$ROOT_DIR/build-web.sh"
  else
    info "web/ unchanged, skipping the storefront build. Use --build-web to force it."
  fi

  log "Deploy completed at $current_head"
  info "Smoke-test: / (storefront), /vadmin/ (panel), /api/admin/orders,"
  info "an order status change, and a storefront checkout."
}

main "$@"
